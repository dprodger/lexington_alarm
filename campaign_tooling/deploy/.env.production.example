# Production environment for campaign_tooling.
# Copy to the app directory as `.env` (NOT into deploy/) and fill in real values:
#   cp deploy/.env.production.example .env
# config.py loads this via python-dotenv. Keep it out of git (.gitignore
# already excludes .env). chmod 600 it — it holds two secrets.

# Random per-deploy. Rotating it invalidates existing admin sessions.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me

# Supabase Postgres — Session pooler string (port 5432) from
# Project Settings -> Database. URL-encode special chars in the password.
# Tables live in the campaign_tooling schema (hardcoded in app/extensions.py),
# which is selected automatically because this URL starts with postgresql.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Admin gate for /admin. Use a fresh strong value — do NOT reuse dev-admin.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=replace-me
