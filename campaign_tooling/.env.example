# Copy to .env for local development. Do not commit .env.
FLASK_APP=wsgi.py
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production

# Supabase Postgres — required for normal dev. Tables live in the
# campaign_tooling schema (hardcoded in app/extensions.py).
# Use the Session pooler string (port 5432) from Project Settings → Database.
# URL-encode any special chars in the password.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Fallback: leave DATABASE_URL unset to use a local SQLite file. Useful for
# tests; not the recommended dev path.
# DATABASE_URL=sqlite:///campaign_tooling.db

# Crude admin gate while we figure out real auth. Anything truthy enables /admin.
ADMIN_TOKEN=dev-admin
