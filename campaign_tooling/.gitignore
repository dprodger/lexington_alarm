# Secrets — .env.* is also blocked by the parent repo's .gitignore.
# We explicitly un-ignore .env.example so the template ships with the repo.
.env
.env.local
!.env.example
# Ship the production template too — placeholders only, no real secrets.
!deploy/.env.production.example

# Local databases and Flask instance folder
*.db
*.sqlite3
instance/

# Python build / cache artifacts
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/

# Editor state
.idea/
.vscode/

# Meeting notes / private chat transcripts — kept locally, not committed
conversations/
